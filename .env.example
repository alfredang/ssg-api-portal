SSG_API_BASE_URL=https://public-api.ssg-wsg.sg
SSG_CLIENT_ID=your_client_id_here
SSG_CLIENT_SECRET=your_client_secret_here
PORT=3001

# ── App environment / deployment (Coolify) ───────────────────────
# Set NODE_ENV=production on the remote (Coolify) deployment.
# NODE_ENV=production

# ── Per-user defaults storage (file-based — replaces Firestore) ──
# Defaults are saved to a JSON file under this directory. On Coolify,
# mount a persistent volume here so they survive redeploys.
# DATA_DIR=/app/server/data
# Optional: pin the storage ID reported by the admin storage check after the
# existing data folder is attached. A missing/different folder then stops startup.
# PORTAL_DATA_ID=

# ── Authentication ───────────────────────────────────────────────
# Localhost requires NO login by default. Remote (NODE_ENV=production)
# requires Google sign-in. Override explicitly with AUTH_DISABLED=true|false.
# AUTH_DISABLED=false
SESSION_SECRET=change-me-to-a-long-random-string
# Who may sign in is NOT set here. The user list lives in DATA_DIR/users.json and is managed
# in the console (Users). The admins are fixed (see ADMIN_EMAILS in server/users.js); the seed
# members are in SEED_MEMBERS. Sign-in is by Google or by a 6-digit code sent by email
# (the code needs one of the mail accounts below, or the one saved in console > Settings).
# SESSION_SECRET also encrypts DATA_DIR/settings.enc: changing it discards saved mail settings.
# ── Enquiry emails (Contact and SSG API Services pages) ──────────
# Same approach as tertiaryinfotech.com (ai-cms): the team gets an HTML notification
# (Reply-To the enquirer) and the enquirer gets an HTML acknowledgement.
# Transport, first one set wins:
#   Gmail API (as ai-cms):  GMAIL_USER, GMAIL_CLIENT_ID, GMAIL_CLIENT_SECRET, GMAIL_REFRESH_TOKEN
#   Resend (as the HRMS):   RESEND_API_KEY
#   SMTP:                   SMTP_HOST, SMTP_USER, SMTP_PASS [, SMTP_PORT, SMTP_SECURE]
# Without any, enquiries are only stored and shown in the console.
# GMAIL_USER=enquiry@tertiaryinfotech.com
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# RESEND_API_KEY=re_...
# LEAD_EMAIL_TO=angch@tertiaryinfotech.com        # comma-separated for several
# LEAD_REPLY_TO=enquiry@tertiaryinfotech.com      # Reply-To on the acknowledgement
# LEAD_AUTOREPLY=true                             # false = no acknowledgement to the enquirer
# EMAIL_FROM_LEADS=SSG API Portal <enquiry@tertiaryinfotech.com>   # sender for Resend / SMTP
# Optional: POST each new enquiry (Contact / Services pages) to a chat or CRM webhook.
# LEAD_WEBHOOK_URL=https://hooks.example.com/...
# Google OAuth 2.0 credentials (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must match an Authorized redirect URI in the Google OAuth client, e.g.
# https://your-domain.com/auth/google/callback
GOOGLE_CALLBACK_URL=https://your-domain.com/auth/google/callback

SSG_CERT_API_BASE_URL=https://api.ssg-wsg.sg

# ── SSG mTLS certificates (SECRETS — never commit; keep in .env / a volume) ──
# SSG App convention — same as ai-lms-tms (the reference project):
#   App 1 = CERT_1_*  (Skilleto)    App 2 = CERT_2_*  (TMS_1)
#   App 3 = CERT_3_*  (TMS_3_NEW)   App 4 = OAuth (SSG_CLIENT_ID / SSG_CLIENT_SECRET above)
# The UI sends the chosen app as the x-ssg-app header ('app1'..'app4').
# The PEM files live in ../../ssg-api-certs/app1..app3/ (ssg-appN-cert.pem / ssg-appN-key.pem).
#
# Two ways to supply each cert set (the *_FILE path wins if both are set):
#   A) Persistent storage (recommended on Coolify): point at PEM files on a
#      mounted volume — real newlines, no \n escaping:
#        CERT_1_CERT_FILE=/app/server/.cert/ssg-app1-cert.pem
#        CERT_1_KEY_FILE=/app/server/.cert/ssg-app1-key.pem
#        CERT_1_ENCRYPTION_KEY_FILE=/app/server/.cert/ssg-app1-encryption-key.txt
#   B) Inline env vars (below). Multiline PEM with literal \n is normalised.

# App 1 (Skilleto)
CERT_1_NAME=Skilleto
CERT_1_CERT="-----BEGIN CERTIFICATE-----\nMIIG...\n-----END CERTIFICATE-----"
CERT_1_KEY="-----BEGIN PRIVATE KEY-----\nMIIJ...\n-----END PRIVATE KEY-----"
CERT_1_ENCRYPTION_KEY="your-32-char-encryption-key-here"

# App 2 (TMS_1)
CERT_2_NAME=TMS_1
CERT_2_CERT="-----BEGIN CERTIFICATE-----\nMIIG...\n-----END CERTIFICATE-----"
CERT_2_KEY="-----BEGIN PRIVATE KEY-----\nMIIJ...\n-----END PRIVATE KEY-----"
CERT_2_ENCRYPTION_KEY="your-32-char-encryption-key-here"

# App 3 (TMS_3_NEW)
CERT_3_NAME=TMS_3_NEW
CERT_3_CERT="-----BEGIN CERTIFICATE-----\nMIIG...\n-----END CERTIFICATE-----"
CERT_3_KEY="-----BEGIN PRIVATE KEY-----\nMIIJ...\n-----END PRIVATE KEY-----"
CERT_3_ENCRYPTION_KEY="your-32-char-encryption-key-here"

# App 4 (OAuth) — uses SSG_CLIENT_ID / SSG_CLIENT_SECRET at the top of this file; no PEM.

# ── Our own data in the console ──────────────────────────────────
# UEN whose courses are listed under "WSQ Funded Courses" and offered in the course picker.
# TP_UEN=201200696W
# Read-only link to AI-LMS-TMS: course runs and enrolment reference numbers are suggested
# in the test forms. The portal only sends GET requests and drops learner details, but
# AI-LMS-TMS has a single service key that can also write, so keep it server-side only.
# LMS_TMS_BASE_URL=https://lms-tms.tertiaryinfotech.com
# LMS_TMS_API_KEY=

# ── Conformance tests (SSG UAT only) ─────────────────────────────
# The certificate, private key and AES key registered for UAT. Each also accepts a
# *_FILE path. UAT_ENCRYPTION_KEY is the base64 value only (32 bytes), not a notes file.
# UAT_API_BASE=https://uat-api.ssg-wsg.sg
# UAT_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# UAT_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# UAT_ENCRYPTION_KEY=
